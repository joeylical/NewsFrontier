{
  "database": {
    "embedding_dimension": 768,
    "default_rss_fetch_interval": 60,
    "max_processing_attempts": 3,
    "similarity_threshold": 0.62,
    "cluster_threshold": 0.75,
    "max_articles_per_event": 50
  },
  "llm_models": [
    {
      "name": "default_chat",
      "model_type": "chat",
      "provider": "openai",
      "model_name": "gpt-3.5-turbo",
      "is_active": true,
      "description": "Default chat model for conversations and text generation"
    },
    {
      "name": "default_embedding",
      "model_type": "embedding", 
      "provider": "openai",
      "model_name": "text-embedding-ada-002",
      "is_active": true,
      "description": "Default embedding model for vector operations"
    },
    {
      "name": "advanced_chat",
      "model_type": "chat",
      "provider": "openai", 
      "model_name": "gpt-4",
      "is_active": true,
      "description": "Advanced chat model for complex reasoning tasks"
    },
    {
      "name": "large_embedding",
      "model_type": "embedding",
      "provider": "openai",
      "model_name": "text-embedding-3-large", 
      "is_active": true,
      "description": "Large embedding model for high-quality vectors"
    },
    {
      "name": "default_image",
      "model_type": "image",
      "provider": "openai",
      "model_name": "dall-e-3",
      "is_active": true,
      "description": "Default image generation model for creating visual content"
    }
  ],
  "features": {
    "daily_summary_enabled": "false",
    "daily_summary_cover_enabled": "true"
  },
  "processing": {
    "scraper_interval_minutes": 60,
    "postprocess_interval_minutes": 30,
    "max_article_age_days": 7,
    "batch_processing_size": 20,
    "batch_processing_enabled": "true"
  },
  "storage": {
    "s3_region": "us-east-1"
  },
  "prompts": {
    "summary_creation": "prompts/summary_creation.txt",
    "cluster_detection": "prompts/cluster_detection.txt",
    "daily_summary_system": "prompts/daily_summary_system.txt",
    "cover_image_generation": "prompts/cover_image_generation.txt"
  }
}
